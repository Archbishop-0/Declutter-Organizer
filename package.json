{
  "name": "declutter",
  "productName": "Declutter",
  "version": "1.0.0",
  "description": "Minimal, elegant matte black workspace and folder organizer",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -r \"cross-env NODE_ENV=development vite\" \"wait-on tcp:5173 && electron .\"",
    "web": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable nsis",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "folder-organizer",
    "declutter",
    "desktop-cleaner",
    "electron",
    "react"
  ],
  "author": "archbishop",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.7.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.archbishop.declutter",
    "productName": "Declutter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Declutter"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Declutter-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Declutter-Portable.exe"
    }
  }
}
